<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="326.0" prefWidth="376.0" spacing="10" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="main.java.edu.kinal.reclutamiento.controller.LoginController">
   <AnchorPane prefHeight="308.0" prefWidth="376.0">
      <children>
           <Label layoutX="178.0" layoutY="38.0" text="Correo:" />
           <TextField fx:id="txtCorreo" layoutX="123.0" layoutY="72.0" promptText="Ingresa tu correo" />
      
           <Label layoutX="166.0" layoutY="115.0" text="Contraseña:" />
           <PasswordField fx:id="txtContrasena" layoutX="123.0" layoutY="142.0" promptText="Ingresa tu contraseña" />
      
             <Label layoutX="128.0" layoutY="14.0" text="Sistema de Reclutamiento" />
           <Button layoutX="160.0" layoutY="243.0" onAction="#irRegistro" text="Registrarse" />
           <Button layoutX="155.0" layoutY="197.0" onAction="#iniciarSesion" text="Iniciar sesión" />
      </children>
   </AnchorPane>

    <HBox alignment="CENTER" spacing="10" />

</VBox>
